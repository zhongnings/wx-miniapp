.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.15);
}

.navbar-left,
.navbar-right {
  width: 80rpx;
}

.back-icon {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 表单容器 */
.form-container {
  margin-top: 108rpx;
  background: #ffffff;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-label {
  width: 200rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.required {
  color: #ff6b6b;
  margin-right: 8rpx;
}

.form-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
}

.form-text {
  font-size: 28rpx;
  color: #333333;
}

.form-text.placeholder {
  color: #999999;
}

.unit {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.arrow {
  margin-left: 16rpx;
  font-size: 40rpx;
  color: #cccccc;
  font-weight: 300;
}

.tag {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  background: #fff0f6;
  color: #eb2f96;
  font-size: 24rpx;
  border-radius: 8rpx;
}

/* 底部按钮 */
.footer-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  padding: 0;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #ffffff;
}

.btn::after {
  border: none;
}

