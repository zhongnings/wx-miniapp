/* 搜索栏 */
.search-section {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #ffffff;
  gap: 20rpx;
  /* 如果启用自定义导航栏，取消下面这些注释 */
  /* position: fixed; */
  /* top: calc(44px + var(--status-bar-height, 20px)); */
  /* left: 0; */
  /* right: 0; */
  /* z-index: 999; */
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon-image {
  width: 40rpx;
  height: 40rpx;
}

.icon-text {
  font-size: 36rpx;
  color: #666;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 20rpx;
  height: 64rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #999;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 标签页和状态筛选 */
.tabs-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  /* 如果启用自定义导航栏，取消下面这些注释 */
  /* position: fixed; */
  /* top: calc(44px + var(--status-bar-height, 20px) + 104rpx); */
  /* left: 0; */
  /* right: 0; */
  /* z-index: 998; */
}

.tabs {
  display: flex;
  gap: 60rpx;
}

.tab {
  position: relative;
  font-size: 28rpx;
  color: #666;
  padding-bottom: 10rpx;
}

.tab.active {
  color: #ff6f6f;
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #ff6f6f;
}

.badge {
  position: absolute;
  top: 0rpx;
  right: -45rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #ff6f6f;
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 18rpx;
  padding: 0 5rpx;
  box-sizing: border-box;
}

.status-filter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #666;
  
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

/* 订单列表 */
.order-list {
  height: calc(100vh - 300rpx);
  padding-top: 20rpx;
  padding-left: 1%;
  width: 98%;
  /* 说明：使用百分比宽度和左边距，适配不同屏幕宽度，避免小屏幕左边距过大 */
  box-sizing: border-box;
  /* 隐藏滚动条 - 多种方法组合使用 */
  scrollbar-width: none !important; /* Firefox */
  -ms-overflow-style: none !important; /* IE 10+ */
  /* 微信小程序 scroll-view 滚动条隐藏 */
  overflow-y: auto;
}

/* 隐藏滚动条 - Webkit 浏览器（包括微信小程序） */
.order-list::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  background: transparent !important;
  opacity: 0 !important;
}

/* 隐藏滚动条轨道和滑块 */
.order-list::-webkit-scrollbar-track {
  display: none !important;
  background: transparent !important;
}

.order-list::-webkit-scrollbar-thumb {
  display: none !important;
  background: transparent !important;
}

.order-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  /*border-left: 4rpx solid #ff6f6f;*/
}

.order-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.order-row:last-child {
  margin-bottom: 0;
}

.order-header-row {
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no-row {
  position: relative;
  padding-right: 110rpx; /* 为右侧操作区域预留空间，避免贴边 */
}

.label {
  color: #666;
  margin-right: 16rpx;
  min-width: 140rpx;
}

.label-large {
  font-size: 38rpx;
  font-weight: 500;
}

.value {
  color: #333;
  flex: 1;
}

.value-large {
  font-size: 32rpx;
  font-weight: 500;
}

.amount {
  color: #ff6f6f;
  font-weight: 500;
  font-size: 32rpx;
}

.unit {
  color: #666;
  margin-left: 4rpx;
}

.order-no {
  flex: 1;
  word-break: break-all; /* 订单号过长时自动换行，避免挤压右侧按钮 */
}

.status-link {
  position: absolute;
  margin-left: auto;
  color: #ff6f6f;
  font-size: 28rpx;
  white-space: nowrap;
  right: 40rpx; /* 保持与操作按钮之间有间距 */
}

.order-actions {
  position: absolute;
  right: 0;
  top: 35%;
  transform: translateY(-50%);
  display: flex;
  gap: 20rpx;
}

.action-icon {
  font-size: 32rpx;
  padding: 8rpx;
}

.copy-icon {
  color: #666;
}

.delete-icon {
  color: #ff6f6f;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
}

.loading-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}

.no-more-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 20rpx 0;
}

/* 右下角浮动按钮 */
.fab {
  position: fixed;
  right: 0rpx; /* 贴近右侧边缘 */
  bottom: 150rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 40rpx;
  background: #ff6f6f;
  color: #ffffff;
  border-radius: 50rpx 0 0 50rpx; /* 左侧圆角，右侧直角 */
  box-shadow: 0 4rpx 12rpx rgba(255, 111, 111, 0.4);
  z-index: 999;
  cursor: pointer;
}

.fab-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fab-icon-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-sizing: border-box;
}

.fab-icon {
  font-size: 26rpx;
  line-height: 1;
  color: #ffffff;
  font-weight: bold;
}

.fab-divider {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #ffffff;
}

.fab-text {
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* 状态选择器 */
.status-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: none;
  align-items: flex-end;
}

.status-picker-mask.show {
  display: flex;
}

.status-picker {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 60vh;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-cancel,
.picker-confirm {
  font-size: 28rpx;
  color: #ff6f6f;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.picker-content {
  max-height: 50vh;
  overflow-y: auto;
  padding: 20rpx 0;
  text-align: center;
  /* 隐藏滚动条 */
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE 10+ */
}

/* 隐藏滚动条 - Webkit 浏览器 */
.picker-content::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}

.picker-item {
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-item.selected {
  color: #ff6f6f;
  background: #fff5f5;
}

/* 菜单抽屉 */
.menu-drawer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: none;
}

.menu-drawer.show {
  display: block;
}

.menu-content {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 70%;
  max-width: 500rpx;
  background: #ffffff;
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.1);
  animation: slideLeft 0.3s ease-out;
}

@keyframes slideLeft {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(0);
  }
}

.menu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #ff6f6f;
  color: #ffffff;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 500;
}

.menu-close {
  font-size: 48rpx;
  line-height: 1;
}

.menu-list {
  padding: 20rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  border-left: 6rpx solid transparent;
  position: relative;
}

.menu-item.active {
  color: #ff6f6f;
  background: #fff5f5;
  border-left-color: #ff6f6f;
  font-weight: 500;
}

.menu-text {
  flex: 1;
}

.menu-check {
  color: #ff6f6f;
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 16rpx;
}

