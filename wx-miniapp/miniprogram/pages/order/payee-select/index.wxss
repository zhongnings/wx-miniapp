.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.15);
}

.navbar-left,
.navbar-right {
  width: 80rpx;
}

.back-icon {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 收款方列表 */
.payee-list {
  margin-top: 108rpx;
  padding: 24rpx 32rpx;
}

.payee-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.payee-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.payee-icon {
  width: 64rpx;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.icon-text {
  font-size: 36rpx;
}

.payee-title {
  flex: 1;
}

.payee-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.payee-select {
  flex-shrink: 0;
}

.select-text {
  display: inline-block;
  min-width: 100rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  padding: 0 20rpx;
  background: #ffffff;
  border: 2rpx solid #ff6b6b;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #ff6b6b;
}

.payee-detail {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-left: 80rpx;
}

.detail-row {
  display: flex;
  font-size: 28rpx;
  line-height: 1.6;
}

.detail-label {
  color: #999999;
  flex-shrink: 0;
  min-width: 180rpx;
}

.detail-value {
  color: #666666;
  flex: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 底部按钮 */
.footer-button {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  padding: 0;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #ffffff;
}

.btn::after {
  border: none;
}

