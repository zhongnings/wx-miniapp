.container {
  height: 100vh;
  background-color: #f5f5f5;
  padding: 32rpx;
  box-sizing: border-box;
}

.item {
  /*background-color: #fff;*/
  /*border-radius: 16rpx;*/
  padding: 32rpx;
  margin-bottom: 24rpx;
  /*box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);*/
  position: relative;
  display: flex;
  align-items: flex-start;
}

.icon-wrapper {
  flex-shrink: 0;
  margin-right: 24rpx;
  margin-top: 4rpx;
  position: relative;
  z-index: 1;
  align-self: stretch;
}

/* 在图标下方添加灰色竖线，延伸到与 content 区域一样的高度 */
.item:not(:last-child) .icon-wrapper::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 68rpx;  /* 调整这个值控制竖线起始位置（增大=向下移动，减小=向上移动） */
  bottom: -6rpx;  /* 调整这个值控制竖线结束位置（增大=延长，减小=缩短） */
  width: 3rpx;
  background-color: #bfbfbf;
  transform: translateX(-50%);
}

/* 在竖线顶部添加向上的箭头符号 */
.item:not(:last-child) .icon-wrapper::before {
  content: '^';
  position: absolute;
  left: 50%;
  top: 52rpx;
  transform: translateX(-50%);
  color: #bfbfbf;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1;
  z-index: 2;
}

.icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 3;
  margin-top: -4px;
}

.icon-check {
  background-color: #1890ff;
}

.icon-warning {
  background-color: #ffa940;
}

.icon-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.content {
  flex: 1;
}

.stage {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.latest .stage {
  color: #ffa940;
}

.row {
  font-size: 28rpx;
  color: #666;
  line-height: 44rpx;
}

.row:last-child {
  margin-bottom: 0;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

