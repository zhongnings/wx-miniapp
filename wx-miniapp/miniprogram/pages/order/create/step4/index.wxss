@import '../step1/index.wxss';

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
  padding-left: 1%;
  width: 98%;
  min-height: 60vh;
  /* 说明：使用百分比宽度和左边距，适配不同屏幕宽度，避免小屏幕左边距过大 */
  box-sizing: border-box;
}

.empty-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-illustration {
  position: relative;
  width: 400rpx;
  height: 300rpx;
  margin-bottom: 60rpx;
}

.building {
  position: absolute;
  width: 120rpx;
  height: 180rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 8rpx;
}

.building-left {
  left: 0;
  top: 40rpx;
}

.building-right {
  right: 0;
  top: 40rpx;
}

.calendar-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.calendar-lines {
  width: 100rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 4rpx;
}

.calendar-person {
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
}

.arrow-up {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 20rpx solid rgba(0, 0, 0, 0.05);
}

.arrow-left {
  left: 60rpx;
  bottom: 20rpx;
}

.arrow-right {
  right: 60rpx;
  bottom: 20rpx;
}

.add-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  border: 2rpx dashed #ff6f6f;
  border-radius: 12rpx;
  background: #ffffff;
  color: #ff6f6f;
  font-size: 28rpx;
}

.add-icon {
  font-size: 32rpx;
  font-weight: bold;
}

/* 担保人卡片 */
.co-borrower-card {
  position: relative;
  margin: 30rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 删除图标 */
.card-delete-icon {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  filter: brightness(0) saturate(100%) invert(60%) sepia(0%) saturate(0%) hue-rotate(0deg) brightness(95%) contrast(90%);
}

.card-delete-icon .icon-image {
  width: 32rpx;
  height: 32rpx;
}

/* 姓名行 */
.card-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.name-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.name-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* 信息行 */
.card-info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.card-info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  min-width: 200rpx;
  color: #666;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #333;
  word-break: break-all;
}
