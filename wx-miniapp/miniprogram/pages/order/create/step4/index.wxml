<view class="create-order-container">

  <!-- 标签页导航 -->
  <scroll-view 
    class="tabs-nav" 
    scroll-x="true" 
    scroll-left="{{tabsScrollLeft}}"
    scroll-with-animation="{{true}}"
    enhanced="true"
    show-scrollbar="{{false}}"
    bindscroll="onTabsScroll"
  >
    <view class="tabs-nav-inner">
      <view class="tab {{currentStep === 0 ? 'active' : ''}} {{fromOrderDetail ? 'clickable' : ''}}" data-step="0" bindtap="onTabClick">借款信息</view>
      <view class="tab {{currentStep === 1 ? 'active' : ''}} {{fromOrderDetail ? 'clickable' : ''}}" data-step="1" bindtap="onTabClick">借款人信息</view>
      <view class="tab {{currentStep === 2 ? 'active' : ''}} {{fromOrderDetail ? 'clickable' : ''}}" data-step="2" bindtap="onTabClick">共借人信息</view>
      <view class="tab {{currentStep === 3 ? 'active' : ''}} {{fromOrderDetail ? 'clickable' : ''}}" data-step="3" bindtap="onTabClick">担保人信息</view>
      <view class="tab {{currentStep === 4 ? 'active' : ''}} {{fromOrderDetail ? 'clickable' : ''}}" data-step="4" bindtap="onTabClick">银行卡信息</view>
      <view class="tab {{currentStep === 5 ? 'active' : ''}} {{fromOrderDetail ? 'clickable' : ''}}" data-step="5" bindtap="onTabClick">资料上传</view>
    </view>
  </scroll-view>

  <!-- 内容区域 -->
  <scroll-view class="form-content" scroll-y="true" scroll-x="false" enhanced="true" show-scrollbar="{{false}}">
    <!-- 无担保人状态 -->
    <view class="empty-state" wx:if="{{!hasGuarantor}}">
      <view class="empty-illustration">
        <view class="building building-left"></view>
        <view class="calendar-icon">
          <view class="calendar-lines"></view>
          <view class="calendar-person"></view>
        </view>
        <view class="building building-right"></view>
        <view class="arrow-up arrow-left"></view>
        <view class="arrow-up arrow-right"></view>
      </view>
      <view class="empty-tip">担保人信息为可选项</view>
      <button class="add-button" bindtap="editGuarantor">
        <text class="add-icon">+</text>
        <text>添加担保人</text>
      </button>
    </view>

    <!-- 已有担保人 -->
    <view class="co-borrower-card" wx:if="{{hasGuarantor}}" bindtap="editGuarantor">
      <!-- 删除图标 -->
      <view class="card-delete-icon" catchtap="deleteGuarantor">
        <image class="icon-image" src="/static/delete_icon.png" mode="aspectFit"></image>
      </view>
      
      <!-- 个人类型 -->
      <block wx:if="{{guarantor.borrowerType === 'personal'}}">
        <view class="card-name-row">
          <text class="name-icon">👤</text>
          <text class="name-text">{{guarantor.name || '未填写'}}</text>
        </view>
        <view class="card-info-row">
          <text class="info-label">担保人姓名：</text>
          <text class="info-value">{{guarantor.name || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.relationship}}">
          <text class="info-label">与主借人关系：</text>
          <text class="info-value">{{guarantor.relationship || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.phone}}">
          <text class="info-label">手机号码：</text>
          <text class="info-value">{{guarantor.phone || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.idNumber}}">
          <text class="info-label">身份证号码：</text>
          <text class="info-value">{{guarantor.idNumber || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.idAddress}}">
          <text class="info-label">身份证地址：</text>
          <text class="info-value">{{guarantor.idAddress || '未填写'}}</text>
        </view>
      </block>
      
      <!-- 对公类型 -->
      <block wx:if="{{guarantor.borrowerType === 'company'}}">
        <view class="card-name-row">
          <text class="name-icon">🏢</text>
          <text class="name-text">{{guarantor.companyName || '未填写'}}</text>
        </view>
        <view class="card-info-row">
          <text class="info-label">公司名称：</text>
          <text class="info-value">{{guarantor.companyName || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.companyCreditCode}}">
          <text class="info-label">信用代码：</text>
          <text class="info-value">{{guarantor.companyCreditCode || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.companyArea}}">
          <text class="info-label">注册地：</text>
          <text class="info-value">{{guarantor.companyArea || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.agentName}}">
          <text class="info-label">经办人：</text>
          <text class="info-value">{{guarantor.agentName || '未填写'}}</text>
        </view>
      </block>
      
      <!-- 房产类型 -->
      <block wx:if="{{guarantor.borrowerType === 'property'}}">
        <view class="card-name-row">
          <text class="name-icon">🏠</text>
          <text class="name-text">房产担保</text>
        </view>
        <view class="card-info-row">
          <text class="info-label">房产证号码：</text>
          <text class="info-value">{{guarantor.companyCreditCode || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.companyArea}}">
          <text class="info-label">房产地：</text>
          <text class="info-value">{{guarantor.companyArea || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.companyAddress}}">
          <text class="info-label">详细地址：</text>
          <text class="info-value">{{guarantor.companyAddress || '未填写'}}</text>
        </view>
        <view class="card-info-row" wx:if="{{guarantor.agentName}}">
          <text class="info-label">经办人：</text>
          <text class="info-value">{{guarantor.agentName || '未填写'}}</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 底部按钮 -->
  <view class="footer-buttons">
    <button class="btn btn-secondary" bindtap="goPrev">上一步</button>
    <button class="btn btn-primary" bindtap="goNext">下一步</button>
  </view>
</view>
