/* 复用step1的样式 */
@import '../step1/index.wxss';

/* 标签页导航 - 支持横向滚动 */
.tabs-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
  white-space: nowrap;
}

.tabs-nav-inner {
  display: inline-flex;
  height: 100%;
  align-items: center;
}

.tab {
  display: inline-block;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  flex-shrink: 0;
  white-space: nowrap;
  box-sizing: border-box;
  min-width: 150rpx;
  text-align: center;
}

.tab.active {
  color: #ff6f6f;
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30rpx;
  right: 30rpx;
  height: 4rpx;
  background: #ff6f6f;
}

/* 身份证上传区域 */
.upload-section {
  background: #ffffff;
  margin: 20rpx auto;
  margin-left: 1%;
  width: 98%;
  border-radius: 16rpx;
  padding: 30rpx;
  /* 说明：使用百分比宽度和左边距，适配不同屏幕宽度，避免小屏幕左边距过大 */
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
}

.id-upload-wrapper {
  display: flex;
  gap: 20rpx;
}

.id-upload-item {
  flex: 1;
  position: relative;
}

.id-image-wrapper {
  position: relative;
  width: 100%;
}

.id-image {
  width: 95%;
  height: 220rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ddd;
}

.delete-icon {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.delete-icon-text {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1;
  margin-bottom: 8rpx;
}

.upload-tip {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  margin-top: 16rpx;
}

/* 表单输入框样式调整 */
.form-item .input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.form-item .input::placeholder {
  color: #999;
}

