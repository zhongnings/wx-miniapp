.bank-card-edit-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 表单内容 */
.form-content {
  height: calc(100vh - 120rpx);
}

/* 上传区域 */
.upload-section {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.image-upload-area {
  width: 100%;
}

.image-preview {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.image-preview:active .image-mask {
  opacity: 1;
}

.preview-text {
  color: #fff;
  font-size: 28rpx;
}

.image-upload-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 400rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  background: #fff;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
}

/* 表单区域 */
.form-section {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.section-tip {
  font-size: 24rpx;
  color: #ff6f6f;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.label.required::before {
  content: '*';
  color: #ff6f6f;
  margin-right: 4rpx;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  gap: 40rpx;
}

.radio-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #333;
}

/* 输入框 */
.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.input[disabled] {
  color: #999;
}

.arrow {
  position: absolute;
  right: 20rpx;
  font-size: 32rpx;
  color: #999;
}

/* 底部保存按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.save-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #ff6f6f 0%, #ff8e8e 100%);
  border-radius: 40rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  opacity: 0.8;
}

/* 选择器触发器（隐藏） */
.picker-trigger {
  display: none;
}

