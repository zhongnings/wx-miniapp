@import '../step1/index.wxss';

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
  padding-left: 1%;
  width: 98%;
  min-height: 60vh;
  /* 说明：使用百分比宽度和左边距，适配不同屏幕宽度，避免小屏幕左边距过大 */
  box-sizing: border-box;
}

.empty-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-illustration {
  position: relative;
  width: 400rpx;
  height: 300rpx;
  margin-bottom: 60rpx;
}

.building {
  position: absolute;
  width: 120rpx;
  height: 180rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 8rpx;
}

.building-left {
  left: 0;
  top: 40rpx;
}

.building-right {
  right: 0;
  top: 40rpx;
}

.calendar-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.calendar-lines {
  width: 100rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 4rpx;
}

.calendar-person {
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
}

.arrow-up {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 20rpx solid rgba(0, 0, 0, 0.05);
}

.arrow-left {
  left: 60rpx;
  bottom: 20rpx;
}

.arrow-right {
  right: 60rpx;
  bottom: 20rpx;
}

.add-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  border: 2rpx dashed #ff6f6f;
  border-radius: 12rpx;
  background: #ffffff;
  color: #ff6f6f;
  font-size: 28rpx;
}

.add-icon {
  font-size: 32rpx;
  font-weight: bold;
}

/* 共借人卡片 */
.co-borrower-card {
  margin: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.card-title {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

.card-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.edit-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.delete-btn:active {
  background: rgba(255, 111, 111, 0.3);
}

.card-content {
  padding: 30rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.info-row .value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

