<view class="fulldetail-container">
  <scroll-view class="content-area" scroll-y="true" enhanced="true" show-scrollbar="false">
    
    <!-- 订单摘要 -->
    <view class="section-card summary-section">
      <view class="section-title-bar">
        <view class="title-indicator"></view>
        <text class="section-title">订单摘要</text>
        <view class="collapse-icon" bindtap="toggleSection" data-section="summary">
          <text class="{{expandedSections.summary ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.summary}}">
        <view class="info-row">
          <text class="info-label">借款人员：</text>
          <text class="info-value">{{orderData.borrowerName || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">借款金额：</text>
          <text class="info-value amount">¥ {{orderData.loanAmount || '0.00'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">订单编号：</text>
          <text class="info-value">{{orderData.orderNo || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">订单状态：</text>
          <text class="info-value">{{orderData.orderStatusName || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 1. 借款信息 -->
    <view class="section-card" wx:if="{{loanInfo}}">
      <view class="section-title-bar">
        <view class="title-indicator"></view>
        <text class="section-title">借款信息</text>
        <view class="collapse-icon" bindtap="toggleSection" data-section="loanInfo">
          <text class="{{expandedSections.loanInfo ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.loanInfo}}">
        <view class="info-row">
          <text class="info-label">受让机构：</text>
          <text class="info-value">{{loanInfo.assigneeOrg || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">小贷机构：</text>
          <text class="info-value">{{loanInfo.channelOrg || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">支付渠道：</text>
          <text class="info-value">{{loanInfo.payMethod || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">产品类型：</text>
          <text class="info-value">{{loanInfo.productType || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">借款人类型：</text>
          <text class="info-value">{{loanInfo.borrowerCategory || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">合同签署方式：</text>
          <text class="info-value">{{loanInfo.contractSignMode || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">借款金额：</text>
          <text class="info-value">{{loanInfo.loanAmount || '-'}} 元</text>
        </view>
        <view class="info-row">
          <text class="info-label">借款天数：</text>
          <text class="info-value">{{loanInfo.loanDays || '-'}} 天</text>
        </view>
        <view class="info-row">
          <text class="info-label">借款起始日期：</text>
          <text class="info-value">{{loanInfo.startDate || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">借款结束日期：</text>
          <text class="info-value">{{loanInfo.endDate || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">借款年利率：</text>
          <text class="info-value">{{loanInfo.annualRate || '-'}} %</text>
        </view>
        <view class="info-row">
          <text class="info-label">签约地：</text>
          <text class="info-value">{{loanInfo.signPlace || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">借款用途：</text>
          <text class="info-value">{{loanInfo.usageDesc || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">还款方式：</text>
          <text class="info-value">{{loanInfo.repayMode || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">仲裁机构：</text>
          <text class="info-value">{{loanInfo.arbitrationOrg || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 2. 借款人信息 -->
    <view class="section-card" wx:if="{{borrowerInfo}}">
      <view class="section-title-bar">
        <view class="title-indicator"></view>
        <text class="section-title">借款人信息</text>
        <view class="collapse-icon" bindtap="toggleSection" data-section="borrowerInfo">
          <text class="{{expandedSections.borrowerInfo ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.borrowerInfo}}">
        <!-- 身份证照片 -->
        <view class="id-images-row" wx:if="{{borrowerInfo.idCardFront || borrowerInfo.idCardBack}}">
          <view class="id-image-item" wx:if="{{borrowerInfo.idCardFront}}">
            <image class="id-image" src="{{borrowerInfo.idCardFront}}" mode="aspectFill" bindtap="previewImage" data-url="{{borrowerInfo.idCardFront}}"></image>
            <text class="id-image-label">证件正面</text>
          </view>
          <view class="id-image-item" wx:if="{{borrowerInfo.idCardBack}}">
            <image class="id-image" src="{{borrowerInfo.idCardBack}}" mode="aspectFill" bindtap="previewImage" data-url="{{borrowerInfo.idCardBack}}"></image>
            <text class="id-image-label">证件反面</text>
          </view>
        </view>
        
        <view class="info-row">
          <text class="info-label">证件类型：</text>
          <text class="info-value">{{borrowerInfo.idType || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">姓名：</text>
          <text class="info-value">{{borrowerInfo.name || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">手机号：</text>
          <text class="info-value">{{borrowerInfo.phone || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">证件号码：</text>
          <text class="info-value">{{borrowerInfo.idNumber || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">证件地址：</text>
          <text class="info-value">{{borrowerInfo.idAddress || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">居住地：</text>
          <text class="info-value">{{borrowerInfo.residenceArea || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">婚姻状况：</text>
          <text class="info-value">{{borrowerInfo.maritalStatus || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 3. 共借人信息 -->
    <view class="section-card" wx:if="{{coBorrowerInfo}}">
      <view class="section-title-bar">
        <view class="title-indicator"></view>
        <text class="section-title">共借人信息</text>
        <view class="collapse-icon" bindtap="toggleSection" data-section="coBorrowerInfo">
          <text class="{{expandedSections.coBorrowerInfo ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.coBorrowerInfo}}">
        <view class="info-row">
          <text class="info-label">类型：</text>
          <text class="info-value">{{coBorrowerInfo.borrowerType === 'personal' ? '个人' : '对公'}}</text>
        </view>
        
        <!-- 个人类型 -->
        <block wx:if="{{coBorrowerInfo.borrowerType === 'personal'}}">
          <view class="id-images-row" wx:if="{{coBorrowerInfo.idCardFront || coBorrowerInfo.idCardBack}}">
            <view class="id-image-item" wx:if="{{coBorrowerInfo.idCardFront}}">
              <image class="id-image" src="{{coBorrowerInfo.idCardFront}}" mode="aspectFill" bindtap="previewImage" data-url="{{coBorrowerInfo.idCardFront}}"></image>
              <text class="id-image-label">证件正面</text>
            </view>
            <view class="id-image-item" wx:if="{{coBorrowerInfo.idCardBack}}">
              <image class="id-image" src="{{coBorrowerInfo.idCardBack}}" mode="aspectFill" bindtap="previewImage" data-url="{{coBorrowerInfo.idCardBack}}"></image>
              <text class="id-image-label">证件反面</text>
            </view>
          </view>
          <view class="info-row">
            <text class="info-label">姓名：</text>
            <text class="info-value">{{coBorrowerInfo.name || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">证件号：</text>
            <text class="info-value">{{coBorrowerInfo.idNumber || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">手机号：</text>
            <text class="info-value">{{coBorrowerInfo.phone || '-'}}</text>
          </view>
        </block>
        
        <!-- 对公类型 -->
        <block wx:if="{{coBorrowerInfo.borrowerType === 'company'}}">
          <view class="info-row">
            <text class="info-label">公司名称：</text>
            <text class="info-value">{{coBorrowerInfo.companyName || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">信用代码：</text>
            <text class="info-value">{{coBorrowerInfo.companyCreditCode || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">经办人：</text>
            <text class="info-value">{{coBorrowerInfo.agentName || '-'}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 4. 担保人信息 -->
    <view class="section-card" wx:if="{{guarantorInfo}}">
      <view class="section-title-bar">
        <view class="title-indicator"></view>
        <text class="section-title">担保人信息</text>
        <view class="collapse-icon" bindtap="toggleSection" data-section="guarantorInfo">
          <text class="{{expandedSections.guarantorInfo ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.guarantorInfo}}">
        <view class="info-row">
          <text class="info-label">类型：</text>
          <text class="info-value">{{guarantorInfo.borrowerType === 'personal' ? '个人' : (guarantorInfo.borrowerType === 'property' ? '房产' : '对公')}}</text>
        </view>
        
        <!-- 个人类型 -->
        <block wx:if="{{guarantorInfo.borrowerType === 'personal'}}">
          <view class="id-images-row" wx:if="{{guarantorInfo.idCardFront || guarantorInfo.idCardBack}}">
            <view class="id-image-item" wx:if="{{guarantorInfo.idCardFront}}">
              <image class="id-image" src="{{guarantorInfo.idCardFront}}" mode="aspectFill" bindtap="previewImage" data-url="{{guarantorInfo.idCardFront}}"></image>
              <text class="id-image-label">证件正面</text>
            </view>
            <view class="id-image-item" wx:if="{{guarantorInfo.idCardBack}}">
              <image class="id-image" src="{{guarantorInfo.idCardBack}}" mode="aspectFill" bindtap="previewImage" data-url="{{guarantorInfo.idCardBack}}"></image>
              <text class="id-image-label">证件反面</text>
            </view>
          </view>
          <view class="info-row">
            <text class="info-label">姓名：</text>
            <text class="info-value">{{guarantorInfo.name || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">证件号：</text>
            <text class="info-value">{{guarantorInfo.idNumber || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">手机号：</text>
            <text class="info-value">{{guarantorInfo.phone || '-'}}</text>
          </view>
        </block>
        
        <!-- 对公类型 -->
        <block wx:if="{{guarantorInfo.borrowerType === 'company'}}">
          <view class="info-row">
            <text class="info-label">公司名称：</text>
            <text class="info-value">{{guarantorInfo.companyName || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">信用代码：</text>
            <text class="info-value">{{guarantorInfo.companyCreditCode || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">经办人：</text>
            <text class="info-value">{{guarantorInfo.agentName || '-'}}</text>
          </view>
        </block>
        
        <!-- 房产类型 -->
        <block wx:if="{{guarantorInfo.borrowerType === 'property'}}">
          <view class="info-row">
            <text class="info-label">房产证号码：</text>
            <text class="info-value">{{guarantorInfo.companyCreditCode || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">房产地：</text>
            <text class="info-value">{{guarantorInfo.companyArea || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">经办人：</text>
            <text class="info-value">{{guarantorInfo.agentName || '-'}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 5. 银行卡信息 -->
    <view class="section-card" wx:if="{{bankCards && bankCards.length > 0}}">
      <view class="section-title-bar">
        <view class="title-indicator"></view>
        <text class="section-title">银行卡信息</text>
        <view class="collapse-icon" bindtap="toggleSection" data-section="bankCards">
          <text class="{{expandedSections.bankCards ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.bankCards}}">
        <block wx:for="{{bankCards}}" wx:key="index">
          <view class="bank-card-display">
            <view class="bank-card-header">
              <text class="bank-name">{{item.bankName}}</text>
            </view>
            <view class="bank-card-number">{{item.cardNumber}}</view>
            <view class="bank-card-holder">{{item.cardholderName}}</view>
          </view>
        </block>
      </view>
    </view>

    <!-- 6. 附件材料 -->
    <view class="section-card" wx:if="{{attachments && attachments.length > 0}}">
      <view class="section-title-bar">
        <view class="title-indicator"></view>
        <text class="section-title">附件材料</text>
        <view class="collapse-icon" bindtap="toggleSection" data-section="attachments">
          <text class="{{expandedSections.attachments ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.attachments}}">
        <view class="attachment-list">
          <view class="attachment-status" wx:if="{{attachments.length === 0}}">未上传</view>
          <block wx:for="{{attachments}}" wx:key="index">
            <view class="attachment-item">
              <text class="attachment-name" bindtap="previewAttachment" data-index="{{index}}">{{item.name}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- 7. 合同列表 -->
    <view class="section-card" wx:if="{{contracts && contracts.length > 0}}">
      <view class="section-title-bar">
        <view class="title-indicator"></view>
        <text class="section-title">合同</text>
        <view class="collapse-icon" bindtap="toggleSection" data-section="contracts">
          <text class="{{expandedSections.contracts ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.contracts}}">
        <block wx:for="{{contracts}}" wx:key="id">
          <view class="contract-item">
            <view class="contract-info">
              <text class="contract-name">{{item.name}}</text>
              <text class="contract-time">{{item.createTime}}</text>
            </view>
            <button class="preview-btn" bindtap="previewContract" data-url="{{item.pdfUrl}}">预览</button>
          </view>
        </block>
      </view>
    </view>

    <!-- 8. 制单列表（放款成功后显示） -->
    <view class="section-card" wx:if="{{vouchers && vouchers.length > 0}}">
      <view class="section-title-bar">
        <view class="title-indicator"></view>
        <text class="section-title">制单列表</text>
        <view class="collapse-icon" bindtap="toggleSection" data-section="vouchers">
          <text class="{{expandedSections.vouchers ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.vouchers}}">
        <block wx:for="{{vouchers}}" wx:key="index">
          <view class="voucher-item">
            <view class="voucher-title">制单{{index + 1}}</view>
            <view class="info-row">
              <text class="info-label">金额(元)：</text>
              <text class="info-value">{{item.amount}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">收款方：</text>
              <text class="info-value">{{item.payee}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">收款方类型：</text>
              <text class="info-value">{{item.payeeType}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">开户银行：</text>
              <text class="info-value">{{item.bankName}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">银行卡号：</text>
              <text class="info-value">{{item.bankCardNo}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>

  </scroll-view>
</view>

