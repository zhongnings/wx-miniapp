<!-- 引入WXS文件 -->
<wxs src="../../../utils/formatMoney.wxs" module="formatTool" />

<view class="fulldetail-container">
  <scroll-view class="content-area" scroll-y="true" enhanced="true" show-scrollbar="false">
    
    <!-- 订单信息 -->
    <view class="section-card">
      <view class="section-title-bar" bindtap="toggleSection" data-section="summary">
        <view class="title-indicator"></view>
        <text class="section-title">订单信息</text>
        <view class="collapse-icon">
          <text class="{{expandedSections.summary ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.summary}}">
        <view class="info-row">
          <text class="info-label">借款人员：</text>
          <text class="info-value-left">{{detail.borrowerName || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">借款金额：</text>
          <text class="info-value-left amount">¥ {{formatTool.formatMoney(detail.loanAmount)}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">订单编号：</text>
          <text class="info-value-left">{{detail.orderNo || '-'}}</text>
          <view class="copy-btn" wx:if="{{detail.orderNo}}" bindtap="copyOrderNo" catchtap="copyOrderNo">
            <text class="copy-icon">📋</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-label">订单状态：</text>
          <text class="info-value-left status-text">{{detail.orderStatusName || '-'}}</text>
          <view class="view-progress" bindtap="viewProgress" catchtap="viewProgress">
            <text class="progress-text">查看进度</text>
            <text class="progress-arrow">›</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-label">债转状态：</text>
          <text class="info-value-left">{{detail.debtTransferStatus || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 借款信息 -->
    <view class="section-card" wx:if="{{detail.loanInfo}}">
      <view class="section-title-bar" bindtap="toggleSection" data-section="loanInfo">
        <view class="title-indicator"></view>
        <text class="section-title">借款信息</text>
        <view class="collapse-icon">
          <text class="{{expandedSections.loanInfo ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.loanInfo}}">
        <view class="info-row" wx:if="{{detail.loanInfo.assigneeOrg}}">
          <text class="info-label">受让机构：</text>
          <text class="info-value-left">{{detail.loanInfo.assigneeOrg}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.channelOrg}}">
          <text class="info-label">小贷机构：</text>
          <text class="info-value-left">{{detail.loanInfo.channelOrg}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.payMethod}}">
          <text class="info-label">支付渠道：</text>
          <text class="info-value-left">{{detail.loanInfo.payMethod}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.productType}}">
          <text class="info-label">产品类型：</text>
          <text class="info-value-left">{{detail.loanInfo.productType}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.borrowerCategory}}">
          <text class="info-label">借款人类型：</text>
          <text class="info-value-left">{{detail.loanInfo.borrowerCategory}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.contractSignMode}}">
          <text class="info-label">合同签署方式：</text>
          <text class="info-value-left">{{detail.loanInfo.contractSignMode}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.loanAmount}}">
          <text class="info-label">借款金额：</text>
          <text class="info-value-left">{{formatTool.formatMoney(detail.loanInfo.loanAmount)}} 元</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.loanDays}}">
          <text class="info-label">借款天数：</text>
          <text class="info-value-left">{{detail.loanInfo.loanDays}} 天</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.startDate}}">
          <text class="info-label">借款起始日期：</text>
          <text class="info-value-left">{{detail.loanInfo.startDate}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.endDate}}">
          <text class="info-label">借款结束日期：</text>
          <text class="info-value-left">{{detail.loanInfo.endDate}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.annualRate}}">
          <text class="info-label">借款年利率：</text>
          <text class="info-value-left">{{detail.loanInfo.annualRate}} %</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.signPlace}}">
          <text class="info-label">签约地：</text>
          <text class="info-value-left">{{detail.loanInfo.signPlace}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.usageDesc}}">
          <text class="info-label">借款用途：</text>
          <text class="info-value-left">{{detail.loanInfo.usageDesc}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.repayMode}}">
          <text class="info-label">还款方式：</text>
          <text class="info-value-left">{{detail.loanInfo.repayMode}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.arbitrationOrg}}">
          <text class="info-label">仲裁机构：</text>
          <text class="info-value-left">{{detail.loanInfo.arbitrationOrg}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.notaryOffice}}">
          <text class="info-label">公证处：</text>
          <text class="info-value-left">{{detail.loanInfo.notaryOffice}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.loanInfo.appointmentTime}}">
          <text class="info-label">预约时间：</text>
          <text class="info-value-left">{{detail.loanInfo.appointmentTime}}</text>
        </view>
      </view>
    </view>

    <!-- 借款人信息 -->
    <view class="section-card" wx:if="{{detail.borrowerInfo}}">
      <view class="section-title-bar" bindtap="toggleSection" data-section="borrowerInfo">
        <view class="title-indicator"></view>
        <text class="section-title">借款人信息</text>
        <view class="collapse-icon">
          <text class="{{expandedSections.borrowerInfo ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.borrowerInfo}}">
        <!-- 身份证照片 -->
        <view class="id-images-row" wx:if="{{detail.borrowerInfo.faceFrontUrl || detail.borrowerInfo.faceBackUrl}}">
          <view class="id-image-item" wx:if="{{detail.borrowerInfo.faceFrontUrl}}">
            <image class="id-image" src="{{detail.borrowerInfo.faceFrontUrl}}" mode="aspectFill" bindtap="previewImage" data-url="{{detail.borrowerInfo.faceFrontUrl}}"></image>
            <text class="id-image-label">证件正面</text>
          </view>
          <view class="id-image-item" wx:if="{{detail.borrowerInfo.faceBackUrl}}">
            <image class="id-image" src="{{detail.borrowerInfo.faceBackUrl}}" mode="aspectFill" bindtap="previewImage" data-url="{{detail.borrowerInfo.faceBackUrl}}"></image>
            <text class="id-image-label">证件反面</text>
          </view>
        </view>
        
        <view class="info-row" wx:if="{{detail.borrowerInfo.idType}}">
          <text class="info-label">证件类型：</text>
          <text class="info-value-left">{{detail.borrowerInfo.idType}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.name}}">
          <text class="info-label">姓名：</text>
          <text class="info-value-left">{{detail.borrowerInfo.name}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.idNo}}">
          <text class="info-label">证件号码：</text>
          <text class="info-value-left">{{detail.borrowerInfo.idNo}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.idIssueDate}}">
          <text class="info-label">证件生效日期：</text>
          <text class="info-value-left">{{detail.borrowerInfo.idIssueDate}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.idExpireDate}}">
          <text class="info-label">证件有效期：</text>
          <text class="info-value-left">{{detail.borrowerInfo.idExpireDate}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.addressDetail}}">
          <text class="info-label">证件地址：</text>
          <text class="info-value-left">{{detail.borrowerInfo.addressDetail}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.mobile}}">
          <text class="info-label">手机号码：</text>
          <text class="info-value-left">{{detail.borrowerInfo.mobile}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.provinceCity}}">
          <text class="info-label">居住地：</text>
          <text class="info-value-left">{{detail.borrowerInfo.provinceCity}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.gender}}">
          <text class="info-label">性别：</text>
          <text class="info-value-left">{{detail.borrowerInfo.gender}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.birthday}}">
          <text class="info-label">出生年月：</text>
          <text class="info-value-left">{{detail.borrowerInfo.birthday}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.borrowerInfo.maritalStatus}}">
          <text class="info-label">婚姻状况：</text>
          <text class="info-value-left">{{detail.borrowerInfo.maritalStatus}}</text>
        </view>
      </view>
    </view>

    <!-- 银行卡信息 -->
    <view class="section-card" wx:if="{{detail.bankCards && detail.bankCards.length > 0}}">
      <view class="section-title-bar" bindtap="toggleSection" data-section="bankCards">
        <view class="title-indicator"></view>
        <text class="section-title">银行卡信息</text>
        <view class="collapse-icon">
          <text class="{{expandedSections.bankCards ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content bank-card-content" wx:if="{{expandedSections.bankCards}}">
        <view class="bank-card-item" wx:for="{{detail.bankCards}}" wx:key="id">
          <view class="bank-card" style="background: {{item.bankColor || '#4A90E2'}};">
            <view class="bank-card-header">
              <view class="bank-logo">
                <image class="bank-logo-image" src="{{item.bankLogo}}" mode="aspectFit"></image>
              </view>
              <view class="bank-info">
                <text class="bank-name">{{item.bankName}}</text>
                <text class="cardholder-name">{{item.cardholderName}}</text>
              </view>
            </view>
            <view class="bank-card-number">{{formatTool.formatBankCard(item.cardNumber)}}</view>
            <view class="bank-card-watermark">
              <image class="watermark-logo" src="{{item.bankLogo}}" mode="aspectFit"></image>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 附件材料 -->
    <view class="section-card" wx:if="{{detail.attachments && detail.attachments.length > 0}}">
      <view class="section-title-bar" bindtap="toggleSection" data-section="attachments">
        <view class="title-indicator"></view>
        <text class="section-title">附件材料</text>
        <view class="collapse-icon">
          <text class="{{expandedSections.attachments ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.attachments}}">
        <view class="attachment-list">
          <view class="attachment-item" wx:for="{{detail.attachments}}" wx:key="id" bindtap="previewAttachment" data-index="{{index}}">
            <view class="attachment-info">
              <text class="attachment-icon">📎</text>
              <text class="attachment-name">{{item.name || '附件' + (index + 1)}}</text>
            </view>
            <text class="attachment-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 合同 -->
    <view class="section-card" wx:if="{{detail.contracts && detail.contracts.length > 0}}">
      <view class="section-title-bar" bindtap="toggleSection" data-section="contracts">
        <view class="title-indicator"></view>
        <text class="section-title">合同</text>
        <view class="collapse-icon">
          <text class="{{expandedSections.contracts ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content" wx:if="{{expandedSections.contracts}}">
        <block wx:for="{{detail.contracts}}" wx:key="id">
          <view class="contract-item" bindtap="previewContract" data-url="{{item.pdfUrl}}">
            <view class="contract-info">
              <text class="contract-name">{{item.name || '合同' + (index + 1)}}</text>
              <text class="contract-time" wx:if="{{item.createTime}}">{{item.createTime}}</text>
            </view>
            <text class="contract-arrow">›</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 制单列表 -->
    <view class="section-card" wx:if="{{detail.vouchers && detail.vouchers.length > 0}}">
      <view class="section-title-bar" bindtap="toggleSection" data-section="vouchers">
        <view class="title-indicator"></view>
        <text class="section-title">制单列表</text>
        <view class="collapse-icon">
          <text class="{{expandedSections.vouchers ? 'expanded' : ''}}">^</text>
        </view>
      </view>
      <view class="section-content voucher-content" wx:if="{{expandedSections.vouchers}}">
        <block wx:for="{{detail.vouchers}}" wx:key="id">
          <view class="voucher-card">
            <!-- 收款方和状态 -->
            <view class="voucher-header">
              <text class="payee-name">收款方：{{item.payee || '-'}}</text>
              <text class="voucher-status">{{item.statusText || '待放款申请'}}</text>
            </view>
            
            <!-- 收款方类型 -->
            <view class="info-row" wx:if="{{item.payeeTypeName}}">
              <text class="info-label">收款方类型：</text>
              <text class="info-value-left">{{item.payeeTypeName}}</text>
            </view>
            
            <!-- 收款卡号 -->
            <view class="info-row">
              <text class="info-label">收款卡号：</text>
              <text class="info-value-left">{{formatTool.formatBankCard(item.cardNo)}}</text>
            </view>
            
            <!-- 制单金额 -->
            <view class="info-row">
              <text class="info-label">制单金额：</text>
              <text class="info-value-left amount">{{formatTool.formatMoney(item.amount)}} 元</text>
            </view>
            
            <!-- 开户行 -->
            <view class="info-row" wx:if="{{item.openBank}}">
              <text class="info-label">开户行：</text>
              <text class="info-value-left">{{item.openBank}}</text>
            </view>
            
            <!-- 失败原因 -->
            <view class="info-row" wx:if="{{item.remark}}">
              <text class="info-label">失败原因：</text>
              <text class="info-value-left">{{item.remark}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>

  </scroll-view>
</view>

