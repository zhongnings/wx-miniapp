/* 订单完整详情页面样式 */
.fulldetail-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.content-area {
  height: 100vh;
  padding: 0;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* 区块卡片 */
.section-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 区块标题栏 */
.section-title-bar {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  position: relative;
}

.title-indicator {
  width: 6rpx;
  height: 32rpx;
  background: #ffffff;
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.section-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
}

.collapse-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
}

.collapse-icon text {
  transform: rotate(180deg);
  transition: transform 0.3s;
  display: inline-block;
}

.collapse-icon text.expanded {
  transform: rotate(0deg);
}

/* 区块内容 */
.section-content {
  padding: 24rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  position: relative;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 200rpx;
  color: #666;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #333;
  word-break: break-all;
  text-align: right;
  overflow-wrap: break-word;
}

.info-value-left {
  flex: 1;
  color: #333;
  word-break: break-all;
  text-align: left;
  overflow-wrap: break-word;
}

.info-value.amount,
.info-value-left.amount {
  color: #ff6b6b;
  font-weight: 500;
  font-size: 32rpx;
}

.status-text {
  color: #ff6b6b;
}

.status-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: #e8f5e9;
  color: #4caf50;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 复制按钮 */
.copy-btn {
  margin-left: 16rpx;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-icon {
  font-size: 28rpx;
}

/* 查看进度 */
.view-progress {
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  color: #ff6b6b;
}

.progress-text {
  font-size: 28rpx;
}

.progress-arrow {
  font-size: 32rpx;
  margin-left: 4rpx;
}

/* 身份证图片展示 */
.id-images-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.id-image-item {
  flex: 1;
  min-width: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.id-image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.id-image-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 银行卡展示 - 完全复用 step5 的样式 */
.bank-card-content {
  padding: 20rpx !important;
}

.bank-card-item {
  width: 100%;
  margin-bottom: 30rpx;
}

.bank-card-item:last-child {
  margin-bottom: 0;
}

.bank-card {
  position: relative;
  width: 100%;
  height: 220rpx;
  background: linear-gradient(135deg, #ff6f6f 0%, #ff8e8e 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 111, 111, 0.3);
  overflow: hidden;
  box-sizing: border-box;
}

.bank-card-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.bank-logo {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.bank-logo-image {
  width: 100%;
  height: 100%;
}

.bank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bank-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.cardholder-name {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
}

.bank-card-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.bank-card-watermark {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  width: 100rpx;
  height: 100rpx;
  opacity: 0.15;
}

.watermark-logo {
  width: 100%;
  height: 100%;
}

/* 附件列表 */
.attachment-list {
  padding: 0;
}

.attachment-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.attachment-item:last-child {
  margin-bottom: 0;
}

.attachment-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.attachment-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.attachment-name {
  flex: 1;
  color: #333;
  font-size: 28rpx;
}

/* 合同列表 */
.contract-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.contract-item:last-child {
  margin-bottom: 0;
}

.contract-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.contract-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.contract-time {
  font-size: 24rpx;
  color: #999;
}

.contract-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 16rpx;
}

/* 制单列表内容 */
.voucher-content {
  padding: 20rpx !important;
}

.voucher-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f0f0f0;
}

.voucher-card:last-child {
  margin-bottom: 0;
}

/* 收款方和状态 */
.voucher-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.payee-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.voucher-status {
  font-size: 26rpx;
  color: #ff6b6b;
}

/* 制单信息行 */
.voucher-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.voucher-row:last-of-type {
  margin-bottom: 0;
}

.voucher-row .label {
  color: #666;
  min-width: 140rpx;
}

.voucher-row .value {
  flex: 1;
  color: #333;
  text-align: right;
  word-break: break-all;
}

/* 金额行特殊样式 */
.amount-row {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.amount-row .amount-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #ff6b6b;
}
