/* 订单完整详情页面样式 */
.fulldetail-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.content-area {
  height: 100vh;
  padding: 20rpx;
}

/* 区块卡片 */
.section-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 区块标题栏 */
.section-title-bar {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
}

.summary-section .section-title-bar {
  background: linear-gradient(135deg, #ff6f6f 0%, #ee5a6f 100%);
}

.title-indicator {
  width: 6rpx;
  height: 32rpx;
  background: #ffffff;
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.section-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
}

.collapse-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
}

.collapse-icon text {
  transform: rotate(180deg);
  transition: transform 0.3s;
  display: inline-block;
}

.collapse-icon text.expanded {
  transform: rotate(0deg);
}

/* 区块内容 */
.section-content {
  padding: 30rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  min-width: 180rpx;
  color: #666;
  margin-right: 20rpx;
}

.info-value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

.info-value.amount {
  color: #ff6f6f;
  font-weight: 500;
  font-size: 32rpx;
}

/* 身份证图片展示 */
.id-images-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.id-image-item {
  flex: 1;
  min-width: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.id-image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.id-image-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 银行卡展示 */
.bank-card-display {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  color: #ffffff;
}

.bank-card-display:last-child {
  margin-bottom: 0;
}

.bank-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.bank-name {
  font-size: 32rpx;
  font-weight: 500;
}

.bank-card-number {
  font-size: 36rpx;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
  font-family: 'Courier New', monospace;
}

.bank-card-holder {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 附件列表 */
.attachment-list {
  padding: 0;
}

.attachment-status {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}

.attachment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.attachment-item:last-child {
  border-bottom: none;
}

.attachment-name {
  color: #1890ff;
  font-size: 28rpx;
  text-decoration: underline;
}

/* 合同列表 */
.contract-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contract-item:last-child {
  border-bottom: none;
}

.contract-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.contract-name {
  font-size: 28rpx;
  color: #333;
}

.contract-time {
  font-size: 24rpx;
  color: #999;
}

.preview-btn {
  padding: 12rpx 24rpx;
  background: #1890ff;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1;
}

.preview-btn::after {
  border: none;
}

/* 制单列表 */
.voucher-item {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.voucher-item:last-child {
  margin-bottom: 0;
}

.voucher-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.voucher-item .info-row {
  padding: 12rpx 0;
  border-bottom: none;
}

.voucher-item .info-label {
  min-width: 160rpx;
}

