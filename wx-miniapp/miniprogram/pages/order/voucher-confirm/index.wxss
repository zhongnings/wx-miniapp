.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.15);
}

.navbar-left,
.navbar-right {
  width: 80rpx;
}

.back-icon {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 内容区域 */
.content-area {
  margin-top: 108rpx;
  padding: 0 32rpx;
}

/* 提示文字 */
.tip-text {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 32rpx;
  padding-left: 8rpx;
  padding-top: 10px;
}

/* 信息卡片 */
.info-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  font-size: 28rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  color: #666666;
}

.info-value {
  color: #333333;
  text-align: right;
  flex: 1;
  margin-left: 32rpx;
}

.amount-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

/* 支付密码区域 */
.password-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.password-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 24rpx;
}

.required-mark {
  color: #ff6b6b;
  margin-right: 4rpx;
}

.password-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.password-input::placeholder {
  color: #cccccc;
}

/* 底部按钮 */
.footer-button {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

