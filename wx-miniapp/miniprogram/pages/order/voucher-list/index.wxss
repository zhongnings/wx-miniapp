.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.15);
}

.navbar-left,
.navbar-right {
  width: 80rpx;
}

.back-icon {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 限额提示 */
.limit-notice {
  margin-top: 108rpx;
  margin-left: 32rpx;
  margin-right: 32rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 32rpx;
  background: #fff7e6;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
}

.notice-icon {
  font-size: 32rpx;
  color: #ff9800;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 26rpx;
  color: #ff9800;
  line-height: 1.6;
}

/* 制单列表 */
.voucher-list {
  padding: 0 32rpx;
}

.voucher-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 收款方和状态 */
.voucher-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.payee-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

.voucher-status {
  font-size: 28rpx;
  color: #ff6b6b;
}

/* 信息行 */
.voucher-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.voucher-row:last-of-type {
  margin-bottom: 24rpx;
}

.voucher-row .label {
  color: #666666;
}

.voucher-row .value {
  color: #333333;
  text-align: right;
}

/* 金额行特殊样式 */
.amount-row .amount-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

/* 操作按钮 */
.voucher-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.delete-btn {
  background: #f5f5f5;
  color: #999999;
  min-width: 120rpx;
}

.edit-btn {
  background: #f5f5f5;
  color: #666666;
  min-width: 120rpx;
  margin-left: auto;
  margin-right: 20rpx;
}

.apply-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #ffffff;
  min-width: 180rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-illustration {
  position: relative;
  width: 400rpx;
  height: 300rpx;
  margin-bottom: 40rpx;
}

.building {
  position: absolute;
  bottom: 0;
  width: 80rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #e8e8e8 0%, #f5f5f5 100%);
  border-radius: 8rpx 8rpx 0 0;
}

.building-left {
  left: 20rpx;
}

.building-right {
  right: 20rpx;
}

.calendar-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.calendar-lines {
  position: absolute;
  top: 40rpx;
  left: 30rpx;
  right: 30rpx;
  height: 60rpx;
  border-top: 4rpx solid rgba(255, 255, 255, 0.8);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.8);
}

.calendar-lines::before,
.calendar-lines::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.8);
}

.calendar-lines::before {
  top: 18rpx;
}

.calendar-lines::after {
  top: 36rpx;
}

.calendar-person {
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
}

.calendar-person::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 10rpx 10rpx 0 0;
}

.arrow-up {
  position: absolute;
  bottom: 140rpx;
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-bottom: 30rpx solid #ffcccb;
}

.arrow-left {
  left: 60rpx;
}

.arrow-right {
  right: 60rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 底部按钮 */
.footer-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  padding: 0;
}

.btn-outline {
  background: #ffffff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #ffffff;
}

.btn::after {
  border: none;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

/* 弹窗容器 */
.modal-container {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

/* 弹窗标题 */
.modal-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333333;
  text-align: center;
  margin-bottom: 32rpx;
}

/* 弹窗内容 */
.modal-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  text-align: center;
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
}

/* 弹窗按钮 */
.modal-buttons {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: none;
  padding: 0;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666666;
}

.confirm-btn {
  background: #07c160;
  color: #ffffff;
}
