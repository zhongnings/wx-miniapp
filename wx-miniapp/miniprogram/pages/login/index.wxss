/* 登录页面样式 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  padding: 0;
  display: flex;
  flex-direction: column;
}

/* Logo 区域 */
.logo-section {
  position: relative;
  padding: 80rpx 40rpx 40rpx;
  text-align: center;
  overflow: hidden;
}

.logo-cloud-large {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 300rpx;
  color: rgba(255, 111, 111, 0.1);
  z-index: 0;
}

.logo-cloud-small {
  position: relative;
  font-size: 120rpx;
  color: #ff6f6f;
  z-index: 1;
  margin-bottom: 20rpx;
}

.app-title {
  position: relative;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  z-index: 1;
  margin-bottom: 16rpx;
}

.welcome-text {
  position: relative;
  font-size: 28rpx;
  color: #ff6f6f;
  z-index: 1;
}

/* 登录表单区域 */
.login-form {
  flex: 1;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 60rpx 40rpx 40rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  transition: all 0.3s;
}

.form-title.active {
  font-size: 48rpx;
  color: #ff6f6f;
}

.form-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 60rpx;
}

/* 表单组 */
.form-group {
  margin-bottom: 40rpx;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
}

.input-icon {
  font-size: 36rpx;
  color: #ff6f6f;
  margin-right: 20rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  border: none;
}

.form-input::placeholder {
  color: #999;
}

.password-toggle {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.toggle-icon {
  font-size: 36rpx;
  color: #999;
}

/* 忘记密码 */
.forgot-password {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.forgot-link {
  font-size: 28rpx;
  color: #ff6f6f;
}

.register-link {
  color: #999;
}

/* 用户协议 */
.agreement-section {
  margin-bottom: 100rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.agreement-checkbox {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.agreement-text {
  flex: 1;
  display: inline;
}

.link-text {
  color: #ff6f6f;
}

/* 登录按钮 */
.login-button {
  width: 100%;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-button.active {
  background: linear-gradient(135deg, #ff6f6f 0%, #ee5a6f 100%);
  color: #ffffff;
}

.login-button.disabled {
  background: #e0e0e0;
  color: #999;
}

.login-button::after {
  border: none;
}

