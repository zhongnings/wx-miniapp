<view class="account-list-container">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!hasAccounts && !loading}}">
    <view class="empty-illustration">
      <view class="building building-left"></view>
      <view class="calendar-icon">
        <view class="calendar-lines"></view>
        <view class="calendar-person"></view>
      </view>
      <view class="building building-right"></view>
      <view class="arrow-up arrow-left"></view>
      <view class="arrow-up arrow-right"></view>
    </view>
    <view class="empty-tip">暂无资金账户</view>
    <button class="add-button" bindtap="addAccount">
      <text class="add-icon">+</text>
      <text>新增账户</text>
    </button>
  </view>

  <!-- 账户列表 -->
  <scroll-view class="account-list" scroll-y="true" wx:if="{{hasAccounts}}">
    <view class="account-card" wx:for="{{accountList}}" wx:key="id" bindtap="editAccount" data-id="{{item.id}}">
      <!-- 右上角图标组 -->
      <view class="card-icons">
        <!-- 删除图标 -->
        <view class="card-icon" catchtap="deleteAccount" data-id="{{item.id}}">
          <image class="icon-image" src="{{deleteIconUrl}}" mode="aspectFit"></image>
        </view>
        <!-- 设置图标 -->
        <view class="card-icon" catchtap="settingAccount" data-id="{{item.id}}">
          <image class="icon-image" src="{{settingIconUrl}}" mode="aspectFit"></image>
        </view>
      </view>

      <!-- 账户信息 -->
      <view class="card-header">
        <text class="account-icon">💳</text>
        <text class="account-name">{{item.assignee || '未命名账户'}}</text>
      </view>
      
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">受让方：</text>
          <text class="info-value">{{item.assignee || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">支付渠道：</text>
          <text class="info-value">{{item.paymentChannel || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">小贷机构：</text>
          <text class="info-value">{{item.microloanOrg || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">绑定银行：</text>
          <text class="info-value">{{item.boundBank || '未填写'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">银行账号：</text>
          <text class="info-value">{{item.accountNumber || '未填写'}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 菜单抽屉 -->
  <view class="menu-drawer {{showMenuDrawer ? 'show' : ''}}" bindtap="hideMenu">
    <view class="menu-content" catchtap="stopPropagation">
      <view class="menu-header">
        <text class="menu-title">选择菜单</text>
        <text class="menu-close" bindtap="hideMenu">×</text>
      </view>
      <view class="menu-list">
        <view 
          class="menu-item {{currentMenu === item.key ? 'active' : ''}}"
          wx:for="{{menuList}}" 
          wx:key="key"
          data-key="{{item.key}}"
          data-path="{{item.path}}"
          bindtap="onMenuClick"
        >
          <text class="menu-text">{{item.label}}</text>
          <text class="menu-check" wx:if="{{currentMenu === item.key}}">✓</text>
        </view>
      </view>
    </view>
  </view>
</view>

