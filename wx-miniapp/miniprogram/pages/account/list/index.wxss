.account-list-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
  padding-left: 1%;
  width: 98%;
  min-height: 60vh;
  box-sizing: border-box;
}

.empty-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-illustration {
  position: relative;
  width: 400rpx;
  height: 300rpx;
  margin-bottom: 60rpx;
}

.building {
  position: absolute;
  width: 120rpx;
  height: 180rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 8rpx;
}

.building-left {
  left: 0;
  top: 40rpx;
}

.building-right {
  right: 0;
  top: 40rpx;
}

.calendar-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.calendar-lines {
  width: 100rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 4rpx;
}

.calendar-person {
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
}

.arrow-up {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 20rpx solid rgba(0, 0, 0, 0.05);
}

.arrow-left {
  left: 60rpx;
  bottom: 20rpx;
}

.arrow-right {
  right: 60rpx;
  bottom: 20rpx;
}

.add-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  border: 2rpx dashed #ff6f6f;
  border-radius: 12rpx;
  background: #ffffff;
  color: #ff6f6f;
  font-size: 28rpx;
}

.add-icon {
  font-size: 32rpx;
  font-weight: bold;
}

/* 账户列表 */
.account-list {
  height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 账户卡片 */
.account-card {
  position: relative;
  margin-bottom: 30rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 右上角图标组 */
.card-icons {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 10;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  filter: brightness(0) saturate(100%) invert(60%) sepia(0%) saturate(0%) hue-rotate(0deg) brightness(95%) contrast(90%);
}

.card-icon .icon-image {
  width: 32rpx;
  height: 32rpx;
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.account-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.account-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* 卡片主体 */
.card-body {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  min-width: 180rpx;
  color: #666;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.edit-btn {
  padding: 12rpx 32rpx;
  background: #ff6f6f;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 8rpx;
  border: none;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 菜单抽屉 */
.menu-drawer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: none;
}

.menu-drawer.show {
  display: block;
}

.menu-content {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 500rpx;
  background: #fff;
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
}

.menu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.menu-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.menu-list {
  flex: 1;
  overflow-y: auto;
}

.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item.active {
  background: #fff5f5;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}

.menu-item.active .menu-text {
  color: #ff6f6f;
  font-weight: 500;
}

.menu-check {
  font-size: 32rpx;
  color: #ff6f6f;
}

/* 右下角浮动按钮 */
.fab {
  position: fixed;
  right: 30rpx;
  bottom: 100rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #ff6f6f 0%, #ff8f8f 100%);
  border-radius: 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 111, 111, 0.4);
  z-index: 999;
}

.fab-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-icon-circle {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
}

.fab-icon {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.fab-divider {
  margin: 0 16rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
}

.fab-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

