/* 容器 */
.account-add-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 表单内容区域 */
.form-content {
  flex: 1;
  padding: 20rpx 0;
}

/* 表单区块 */
.form-section {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 0 30rpx;
}

/* 区块标题 */
.section-header {
  padding: 30rpx 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

/* 标签 */
.label {
  flex-shrink: 0;
  width: 220rpx;
  font-size: 28rpx;
  color: #333;
}

.label.required::before {
  content: '*';
  color: #ff6f6f;
  margin-right: 4rpx;
}

/* 输入框包装器 */
.input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  position: relative;
}

/* 输入框 */
.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.input[disabled] {
  background-color: transparent;
  color: #333;
}

.input-placeholder {
  color: #999;
}

/* 箭头 */
.arrow {
  margin-left: 10rpx;
  font-size: 36rpx;
  color: #ccc;
  font-weight: 300;
}

/* 底部按钮区域 */
.footer {
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6f6f 0%, #ff8f8f 100%);
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 111, 111, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

/* 选择器打开时禁止滚动 */
.picker-open .form-content {
  overflow: hidden;
}

/* 选择器弹窗样式 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: none;
  align-items: flex-end;
}

.picker-mask.show {
  display: flex;
}

.picker-container {
  width: 100%;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.picker-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.picker-content {
  flex: 1;
  overflow-y: auto;
}

.picker-item {
  position: relative;
  padding: 30rpx 40rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: center;
  min-height: 80rpx;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-item.selected {
  color: #ff6f6f;
  font-weight: 500;
}

.picker-check {
  position: absolute;
  right: 40rpx;
  font-size: 32rpx;
  color: #ff6f6f;
}

/* value-wrapper 样式 */
.value-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  padding: 0;
}

.value-wrapper .value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.value-wrapper .value.placeholder {
  color: #999;
}

.value-wrapper .arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 10rpx;
  font-weight: 300;
}

