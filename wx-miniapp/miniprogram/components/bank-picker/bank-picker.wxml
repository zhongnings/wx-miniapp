<!-- 银行选择器组件 -->
<view class="bank-picker-overlay {{show ? 'show' : ''}}" catchtap="hide" catchtouchmove="stopScroll">
  <view class="bank-picker-container" catchtap="stopPropagation" catchtouchmove="stopScroll">
    <!-- 标题栏 -->
    <view class="bank-picker-header">
      <text class="bank-picker-title">选择银行</text>
      <text class="bank-picker-close" bindtap="hide">×</text>
    </view>
    
    <!-- 搜索框 -->
    <view class="bank-picker-search">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索银行名称" 
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <view class="search-clear-wrapper" wx:if="{{searchKeyword}}" catchtap="clearSearch">
        <text class="search-clear">×</text>
      </view>
    </view>
    
    <!-- 银行列表 -->
    <scroll-view 
      class="bank-picker-list" 
      scroll-y="true"
      enhanced="true"
      show-scrollbar="{{false}}"
    >
      <view 
        wx:for="{{filteredBankList}}" 
        wx:key="index"
        class="bank-item {{selectedBank === item ? 'selected' : ''}}"
        data-bank="{{item}}"
        bindtap="onBankSelect"
      >
        <text class="bank-name">{{item}}</text>
        <text wx:if="{{selectedBank === item}}" class="check-icon">✓</text>
      </view>
      
      <!-- 无结果提示 -->
      <view wx:if="{{filteredBankList.length === 0}}" class="no-result">
        <text class="no-result-text">未找到匹配的银行</text>
      </view>
    </scroll-view>
    
    <!-- 底部按钮 -->
    <view class="bank-picker-footer">
      <button class="cancel-btn" bindtap="hide">取消</button>
      <button class="confirm-btn" bindtap="onConfirm">确定</button>
    </view>
  </view>
</view>

