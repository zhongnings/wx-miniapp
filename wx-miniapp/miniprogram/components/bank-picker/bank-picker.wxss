/* 银行选择器样式 */

/* 遮罩层 */
.bank-picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 10000;
  display: none;
  overflow: hidden;
  touch-action: none;
}

.bank-picker-overlay.show {
  display: block;
  overflow: hidden;
  touch-action: none;
}

/* 容器 */
.bank-picker-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70vh;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  touch-action: pan-y;
}

/* 标题栏 */
.bank-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.bank-picker-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.bank-picker-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
  padding: 0 10rpx;
}

/* 搜索框 */
.bank-picker-search {
  position: relative;
  padding: 24rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 80rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.search-input::placeholder {
  color: #999999;
}

.search-icon {
  position: absolute;
  left: 72rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999999;
  pointer-events: none;
}

.search-clear-wrapper {
  position: absolute;
  right: 72rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ffffff;
  border-radius: 50%;
  background-color: #cccccc;
  line-height: 1;
}

/* 银行列表 */
.bank-picker-list {
  flex: 1;
  height: 100%;
}

.bank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s;
}

.bank-item:active {
  background-color: #f9f9f9;
}

.bank-item.selected {
  background-color: #fff5f5;
}

.bank-name {
  flex: 1;
  font-size: 32rpx;
  color: #333333;
  text-align: center;
}

.bank-item.selected .bank-name {
  color: #ff6f6f;
  font-weight: 500;
}

.check-icon {
  font-size: 40rpx;
  color: #ff6f6f;
  font-weight: bold;
}

/* 无结果提示 */
.no-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.no-result-text {
  font-size: 28rpx;
  color: #999999;
}

/* 底部按钮 */
.bank-picker-footer {
  display: flex;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  gap: 24rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  padding: 0;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666666;
}

.confirm-btn {
  background-color: #ff6f6f;
  color: #ffffff;
}

.cancel-btn::after,
.confirm-btn::after {
  border: none;
}

