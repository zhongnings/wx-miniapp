/* 省市区选择器样式 */
.region-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: none;
  overflow: hidden;
}

.region-picker-mask.show {
  display: block;
  overflow: hidden;
}

.region-picker-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70vh;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.region-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.region-picker-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.region-picker-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.region-search-box {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f5f5f5;
  margin: 20rpx 30rpx;
  border-radius: 12rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.region-search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  font-size: 36rpx;
  color: #999;
  margin-left: 16rpx;
}

.region-breadcrumb {
  display: flex;
  align-items: center;
  padding: 0 30rpx 20rpx;
  font-size: 28rpx;
  color: #666;
}

.breadcrumb-item {
  color: #ff6f6f;
}

.breadcrumb-separator {
  margin: 0 16rpx;
  color: #999;
}

.region-content-wrapper {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.region-list {
  flex: 1;
  height: 100%;
}

.region-group {
  margin-bottom: 20rpx;
}

.region-group-header {
  padding: 16rpx 30rpx;
  background: #f5f5f5;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.region-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.region-item.selected {
  background: #fff5f5;
}

.region-item-name {
  font-size: 28rpx;
  color: #333;
}

.region-item-check {
  font-size: 32rpx;
  color: #ff6f6f;
}

.region-empty {
  padding: 100rpx 30rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.region-index-bar {
  width: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.region-index-item {
  font-size: 20rpx;
  color: #666;
  padding: 4rpx 0;
  text-align: center;
}

.region-index-item.active {
  color: #ff6f6f;
  font-weight: 500;
}

