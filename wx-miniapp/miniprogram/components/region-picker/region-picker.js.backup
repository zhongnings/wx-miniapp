      const cities = cityMap[provinceName] || [
        { code: provinceCode + '01', name: '市辖区', fullName: provinceName + '市辖区' }
      ];

      this.setData({
        regionCityList: cities,
      });
    },

    /**
     * 加载区县列表
     */
