      const cityName = this.data.selectedCity;
      
      // 简化的区县数据映射（仅列举部分常见城市）
      const districtMap = {
        '广州市': [
          { code: '440103', name: '荔湾区', fullName: '荔湾区' },
          { code: '440104', name: '越秀区', fullName: '越秀区' },
          { code: '440105', name: '海珠区', fullName: '海珠区' },
