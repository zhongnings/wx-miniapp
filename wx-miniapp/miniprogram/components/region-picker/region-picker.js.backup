        ],
        '陕西省': [
          { code: '610100', name: '西安市', fullName: '陕西省西安市' },
          { code: '610200', name: '铜川市', fullName: '陕西省铜川市' }
        ],
        '甘肃省': [
          { code: '620100', name: '兰州市', fullName: '甘肃省兰州市' },
          { code: '620200', name: '嘉峪关市', fullName: '甘肃省嘉峪关市' }
        ],
        '青海省': [
          { code: '630100', name: '西宁市', fullName: '青海省西宁市' }
        ],
        '宁夏回族自治区': [
