<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.loanminiapp.mapper.OrderMapper">

    <resultMap id="OrderResultMap" type="com.example.loanminiapp.entity.Order">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="borrowerName" column="borrower_name"/>
        <result property="loanAmount" column="loan_amount"/>
        <result property="loanDays" column="loan_days"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="annualRate" column="annual_rate"/>
        <result property="orderStatus" column="order_status"/>
        <result property="riskStatus" column="risk_status"/>
        <result property="repaymentStatus" column="repayment_status"/>
        <result property="signStatus" column="sign_status"/>
        <result property="loanInfoFilled" column="loan_info_filled"/>
        <result property="borrowerInfoFilled" column="borrower_info_filled"/>
        <result property="coBorrowerInfoFilled" column="co_borrower_info_filled"/>
        <result property="guarantorInfoFilled" column="guarantor_info_filled"/>
        <result property="bankCardInfoFilled" column="bank_card_info_filled"/>
        <result property="attachmentUploaded" column="attachment_uploaded"/>
        <result property="voucherInfoFilled" column="voucher_info_filled"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 通用查询：按ID获取订单 -->
    <select id="selectById" resultMap="OrderResultMap">
        SELECT * FROM t_order WHERE id = #{id}
    </select>

</mapper>


